# Скрипты и конфиги сервера уезжают на Linux как есть: перевод строки — только LF.
# Без этого Git для Windows запишет CRLF, и bash на SpaceWeb VPS упадёт на \r
# в первой же строке (`bash^M: bad interpreter`).
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.wsgi text eol=lf
*.cgi text eol=lf
# .htaccess уезжает на Apache как есть: CRLF там ломает правила mod_rewrite.
.htaccess text eol=lf
# Батники запускает cmd.exe на Windows: ему нужны CRLF, иначе метки и скобки
# разбираются как часть команды.
*.bat text eol=crlf
