# Хранилище комнат (любой Upstash-Redis: Vercel KV / Marketplace / нативный Upstash).
# Без этих переменных приложение работает с in-memory хранилищем — это ок для
# локальной разработки, но на Vercel данные не переживут перезапуск функции.
#
# Вариант 1 — Vercel KV / Upstash for Redis из Marketplace:
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# Вариант 2 — нативный Upstash:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
