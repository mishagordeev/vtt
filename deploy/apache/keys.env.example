# Ключи хранилища комнат для Python-бэкенда на виртуальном хостинге.
#
# Кладётся рядом с `api.wsgi` как `keys.env`, права 600, в git не попадает
# (файл `keys.env` перечислен в .gitignore). Без ключей API работает с файловым
# хранилищем: `/api/health` ответит `mode: "file"`, комнаты будут жить в
# `python/data/rooms`, а Node-версия их не увидит.
#
# URL и TOKEN должны быть от одной базы Upstash, токен — полный REST, не Readonly.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
