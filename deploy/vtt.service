# VTT «Вторых» как системная служба (Ubuntu/Debian, SpaceWeb VPS).
#
# Раскладка на сервере (её создаёт deploy/bootstrap.sh):
#   /srv/vtt/releases/<хэш>/    распакованная сборка: server.js, .next/static, public
#   /srv/vtt/current            симлинк на действующий релиз (его меняет deploy/activate.sh)
#   /srv/vtt/shared/.env.local  секреты Upstash; деплой этот файл не трогает
#   /srv/vtt/incoming/          архивы релизов от GitHub Actions
#
# Ставится один раз:
#   sudo cp deploy/vtt.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable vtt
#
# Сборка идёт в GitHub Actions (`tools/package-release.cjs`), на сервере npm не нужен:
# запускается готовый `server.js` из standalone-сборки. Секреты читаются из
# shared/.env.local, потому что .env.local нет в архиве (он в .gitignore).

[Unit]
Description=Poison Press VTT (виртуальный стол «Вторые»)
Documentation=https://github.com/mishagordeev/vtt/blob/main/HOSTING.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vtt
Group=vtt
# server.js ищет .next рядом с собой, поэтому рабочая папка — конкретный релиз.
WorkingDirectory=/srv/vtt/current
Environment=NODE_ENV=production
Environment=PORT=3000
# Только localhost: снаружи — nginx (deploy/nginx/vtt.conf).
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
# Минус перед путём — файла может не быть (тогда комнаты живут в памяти процесса).
EnvironmentFile=-/srv/vtt/shared/.env.local
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Пишет Next.js (кеш .next) и сам релиз — только внутри /srv/vtt.
ReadWritePaths=/srv/vtt
UMask=0027

[Install]
WantedBy=multi-user.target
